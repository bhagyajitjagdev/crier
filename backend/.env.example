# Redis carrying the event streams — the only required setting.
# The compose.yml redis maps to host port 6380.
REDIS_URL=redis://localhost:6380/0

# Where templates, config, and the send log live.
# DATA_DIR=./data

# Optional login. Leave unset to run open (fine on a private network);
# set both to require a sign-in.
# AUTH_USERNAME=
# AUTH_PASSWORD=
